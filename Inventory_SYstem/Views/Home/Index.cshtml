@model Inventory_SYstem.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="mb-4">Dashboard</h1>

<div class="row g-3">

    <div class="col-md-3">
        <div class="card text-center shadow">
            <div class="card-body">
                <h5>📦 Total Products</h5>
                <h2>@Model.TotalProducts</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-center shadow">
            <div class="card-body">
                <h5>💰 Inventory Value</h5>
                <h2>₹ @Model.InventoryValue.ToString("N0")</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-center shadow">
            <div class="card-body">
                <h5>📦 Total Stock</h5>
                <h2>@Model.TotalStockQuantity</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-center shadow">
            <div class="card-body">
                <h5>⚠️ Low Stock</h5>
                <h2>@Model.LowStockCount</h2>
            </div>
        </div>
    </div>

</div>

<br />

<div class="row g-3">

    <div class="col-md-3">
        <div class="card text-center shadow">
            <div class="card-body">
                <h5>📥 Total Stock In</h5>
                <h2>@Model.TotalStockIn</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-center shadow">
            <div class="card-body">
                <h5>📤 Total Stock Out</h5>
                <h2>@Model.TotalStockOut</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <a asp-controller="Product"
           asp-action="Category"
           asp-route-category="Electronics"
           style="text-decoration:none;">

            <div class="card text-center shadow">
                <div class="card-body">
                    <h5>💻 Electronics</h5>
                    <h2>@Model.ElectronicsCount</h2>
                </div>
            </div>

        </a>
    </div>

    <div class="col-md-3">
        <a asp-controller="Product"
           asp-action="Category"
           asp-route-category="Furniture"
           style="text-decoration:none;">

            <div class="card text-center shadow">
                <div class="card-body">
                    <h5>🪑 Furniture</h5>
                    <h2>@Model.FurnitureCount</h2>
                </div>
            </div>

        </a>
    </div>

</div>

<br />

<div class="row g-3">

    <div class="col-md-3">
        <a asp-controller="Product"
           asp-action="Category"
           asp-route-category="Grocery"
           style="text-decoration:none;">

            <div class="card text-center shadow">
                <div class="card-body">
                    <h5>🥫 Grocery</h5>
                    <h2>@Model.GroceryCount</h2>
                </div>
            </div>

        </a>
    </div>

    <div class="col-md-3">
        <a asp-controller="Product"
           asp-action="Category"
           asp-route-category="Sports"
           style="text-decoration:none;">

            <div class="card text-center shadow">
                <div class="card-body">
                    <h5>⚽ Sports</h5>
                    <h2>@Model.SportsCount</h2>
                </div>
            </div>

        </a>
    </div>

</div>

<hr class="my-5" />

<div class="row">

    <div class="col-lg-6 mb-4">

        <div class="card shadow">

            <div class="card-header bg-primary text-white">

                <h5 class="mb-0">
                    📊 Products by Category
                </h5>

            </div>

            <div class="card-body">

                <canvas id="categoryChart" height="200"></canvas>

            </div>

        </div>

    </div>

    <div class="col-lg-6 mb-4">

        <div class="card shadow">

            <div class="card-header bg-success text-white">

                <h5 class="mb-0">
                    📈 Stock In vs Stock Out
                </h5>

            </div>

            <div class="card-body">

                <canvas id="stockChart" height="120"></canvas>

            </div>

        </div>

    </div>

</div>
@section Scripts {

    <script>

        const categoryCtx = document.getElementById('categoryChart');

        new Chart(categoryCtx, {

            type: 'pie',

            data: {

                labels: ['Electronics', 'Furniture', 'Grocery', 'Sports'],

                datasets: [{

                    label: 'Products',

                    data: [

                        @Model.ElectronicsCount,

                        @Model.FurnitureCount,

                        @Model.GroceryCount,

                        @Model.SportsCount

                    ],

                    backgroundColor: [

                        '#0d6efd',

                        '#198754',

                        '#ffc107',

                        '#dc3545'

                    ],

                    borderWidth: 2

                }]

            },

            options: {

                responsive: true,
                maintainAspectRatio: false,

                plugins: {

                    legend: {

                        position: 'bottom'

                    }

                }

            }

        });



        const stockCtx = document.getElementById('stockChart');

        new Chart(stockCtx, {

            type: 'bar',

            data: {

                labels: ['Stock In', 'Stock Out'],

                datasets: [{

                    label: 'Quantity',

                    data: [

                        @Model.TotalStockIn,

                        @Model.TotalStockOut

                    ],

                    backgroundColor: [

                        '#198754',

                        '#dc3545'

                    ],

                    borderRadius: 10

                }]

            },

            options: {

                responsive: true,

                scales: {

                    y: {

                        beginAtZero: true

                    }

                },

                plugins: {

                    legend: {

                        display: false

                    }

                }

            }

        });

    </script>

}