@model Inventory_SYstem.Models.User

@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4">

    <div class="card shadow p-4" style="max-width: 600px; margin:auto;">

        <div class="text-center">

            @if (!string.IsNullOrEmpty(Model.ProfilePicture))
            {
                <img src="@Model.ProfilePicture"
                     class="rounded-circle"
                     width="120"
                     height="120" />
            }
            else
            {
                <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center mx-auto"
                     style="width:120px; height:120px; font-size:50px;">
                    👤
                </div>
            }

            <h2 class="mt-3">@Model.Name</h2>

            <p class="text-muted">@Model.Username</p>

        </div>

        <hr />

        <div class="mb-3">
            <strong>📧 Email</strong>
            <p>@Model.Email</p>
        </div>

        <div class="mb-3">
            <strong>📅 Account Created</strong>
            <p>@Model.CreatedAt.ToString("dd MMMM yyyy")</p>
        </div>

        <div class="text-center mt-4">

            <a asp-action="Edit" class="btn btn-primary">
                ✏️ Edit Profile
            </a>

            <a asp-action="ChangePassword" class="btn btn-warning">
                🔐 Change Password
            </a>

        </div>

    </div>

</div>