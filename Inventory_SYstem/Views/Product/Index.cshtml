@model IEnumerable<Inventory_SYstem.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<h1>Product Management</h1>

<hr />

<a asp-action="Create" class="btn btn-primary">
    Add Product
</a>

<table class="table table-bordered mt-3">
    <thead>
        <tr>
            <th>ID</th>
            <th>Product Name</th>
            <th>Category</th>
            <th>Quantity</th>
            <th>Price</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProductId</td>
                <td>@item.ProductName</td>
                <td>@item.Category</td>
                <td>@item.Quantity</td>
                <td>@item.Price</td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.ProductId"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.ProductId"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>
                </td>
            </tr>
        }

    </tbody>
</table>