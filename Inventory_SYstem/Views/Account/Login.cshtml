@{
    ViewData["Title"] = "Login";
    Layout = "_AuthLayout";
}

<div class="container d-flex justify-content-center align-items-center vh-100">

    <div class="card border-0 rounded-4 p-5 shadow-lg"
         style="width:500px; backdrop-filter:blur(10px);">

        <h2 class="text-center text-primary fw-bold mb-2">
            <h2 class="text-center text-primary fw-bold mb-2">
                Welcome Back 
            </h2>

            <p class="text-center text-muted mb-4">
                Login to your account
            </p>
        </h2>

        <p class="text-center text-muted mb-4">
            Sign in to continue
        </p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">
                @ViewBag.Error
            </div>
        }

        <form method="post">

            <div class="mb-3">
                <label class="form-label fw-semibold">Username</label>
                <input type="text"
                       name="username"
                       class="form-control form-control-lg rounded-3 shadow-sm" 
                       placeholder="Enter Username" />
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">Password</label>
                <input type="password"
                       name="password"
                       class="form-control form-control-lg rounded-3 shadow-sm" 
                       placeholder="Enter Password" />
            </div>

            <button type="submit"class="btn btn-primary btn-lg w-100 rounded-3 shadow-sm">
                Login
            </button>
            <div class="text-center my-3">

                <span class="text-muted">
                    OR
                </span>

            </div>

        <button type="button"
                class="btn btn-light border w-100 rounded-3 py-2 shadow-sm">

            <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg"
                 width="20"
                 class="me-2" />

            Continue with Google

        </button>

            <div class="text-center mt-4">

                <span>Don't have an account?</span>

                <a asp-controller="Account"
                   asp-action="Register"
                   class="text-decoration-none fw-bold">

                    Register

                </a>

            </div>

        </form>

    </div>

</div>  